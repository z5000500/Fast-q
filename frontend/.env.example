# Leave both unset for local dev -- Vite's dev-server proxy (see vite.config.ts)
# forwards /api and /socket.io to the local PHP and Node services.
#
# For a production deploy, set these to your deployed backend URLs, e.g.:
# VITE_API_URL=https://fastq-api.onrender.com
# VITE_REALTIME_URL=https://fastq-realtime.onrender.com
VITE_API_URL=
VITE_REALTIME_URL=
